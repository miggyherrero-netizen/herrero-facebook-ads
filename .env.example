# Copy to .env locally. Never paste these values into chat or commit .env.
PORT=4173

# Use the exact public origin where this app is served.
# For a live preview or hosted site, use its stable HTTPS origin.
APP_PUBLIC_URL=http://localhost:4173

# Required before enabling live connector APIs. The login gate is not encryption for browser-local dashboard data.
# Generate a strong value with: openssl rand -base64 32. Configure locally and never share it in chat.
APP_ACCESS_PASSWORD=

# Meta Developer app settings. Leave empty until the app is registered and approved.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:4173/api/connectors/meta/callback
META_API_VERSION=v25.0

# Generate locally with: openssl rand -base64 32
# The decoded value must be exactly 32 bytes. Keep it stable or the encrypted token store cannot be reopened.
TOKEN_ENCRYPTION_KEY=
